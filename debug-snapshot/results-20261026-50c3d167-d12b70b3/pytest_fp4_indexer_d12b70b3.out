                nblocks = (length + 7) // 8
                assert blocks.numel() == blocks.unique().numel() == min(4, nblocks)
                if nblocks:
                    assert nblocks - 1 in blocks.tolist()
                    maxima = torch.full((nblocks * 8,), -torch.inf, device=q.device)
                    maxima[:length] = source_scores[row, :length]
