    echo "时间          : $(ts)"
    echo "主机          : $(hostname)"
    echo "调用者        : ${USER:-$(id -un)}"
    echo "脚本          : $SCRIPT_PATH"
    echo "conf          : $CONF_LOADED"
    echo "配置快照      : $SNAP_FILE"
    echo "日志          : $LOG_FILE"
    echo "PID 文件      : $PID_FILE"
    echo "方案          : resident=${LK_GPU_RESIDENT_MOE_LAYERS} (W4A8) + pool=${LK_POOL_SLOTS} 槽 (W4A16 等价)"
    # 环境被改过的可追溯提示 (lead 要求写进日志头) —— 不影响任何启动参数
    echo "[ENV-PATCH] flashinfer/fused_moe/prepare.py: _process_humming_mxfp4_w4a8_payload 已改为 int32+按专家分块 (bit-equivalent, .orig 已备份, 回滚见 /mnt/SSD01/models/.llm-env/humming/patches/rollback_humming_w4a8_prepare_patch.sh)"
    echo "[ENV-PATCH-2] sglang 两文件作用域补丁 _eager_decode_prewarm 已应用 (预热 DECODE → _cpu_decode), 回滚见 /mnt/SSD01/models/.llm-env/humming/patches/rollback_sglang_dsv41_eager_decode_prewarm_scope.sh"
    echo "[ENV-CHANGE] FLASHINFER_USE_CUDA_NORM 1→0; norm 由 CUDA-JIT 切到 CuTe-DSL; no-op PDL 不变"
    echo "[ENV-CHANGE] chunked-prefill-size 8192→16384; 目的: 令 SuperChunk 注意力 wrapper 的安装门 16384>16384 为假 (attention_backend_setup.py:131-140), 绕开 _flash_mla_with_kvcache_sched_meta 在 eager DECODE 预热下的 SIGSEGV"
    echo "[ENV-CHANGE] (上一条已被备选A取代并回退为 8192) LK_GPU_PREFILL_MIN_TOKENS 1024→0; 关闭 GPU-prefill 档 ⇒ get_super_chunk_size()=0 ⇒ SuperChunk 注意力 wrapper 不安装(解 #7 SIGSEGV); 不再 probe staging 驱动; max_num_batched_tokens 保持 8192"
    echo "[ENV-CHANGE] SGLANG_DSV41_SKIP_CAPTURE_PREWARM=1; 跳过 prepare_before_cuda_graph_capture 的 eager DECODE 预热块(8 轮全部崩在该块内); 风险: 同构 4×H100 无跨架构编译时点差, 最坏是首次 capture 冷编译变慢"
    echo "[ENV-CHANGE] SGLANG_DSV41_AUTOTUNE_DUMMY_DECODE=1; 把 _flashinfer_autotune 的 DECODE dummy 前向标记为 eager decode-prewarm ⇒ 非 resident 层走 _cpu_decode(解 #10 的 autotune 段 _cpu_prefill 段错误); 与 SKIP 门语义独立"
    echo "[ENV-CHANGE] 新增 --disable-flashinfer-autotune; 目的: autotune 的 dummy 前向连崩两次(#10 MoE _cpu_prefill / #11 attention flash_mla), 且它只是内核调参 pass 非服务必需"
    echo "[ENV-CHANGE] 新增 --swa-full-tokens-ratio 0.1(对齐厂商模板; 排除 SWA 池尺寸因素, 预期无效作单变量排除); 注意 SWA 池变大 ⇒ KV footprint 上升"
    echo "[ENV-CHANGE] 2026-10-23 W4A8→W4A16 对照轮: 不传 --flashinfer-mxfp4-moe-precision ⇒ 用默认 default; 非 fp8 ⇒ W4A16 (厂商口径, launch/ 17/17 均不传); 自检判据已随之对调 (EXPECT=W4A16, FORBID=W4A8), 与历史各轮相反"
    echo "[判据] 生效凭据 = '[prewarm-skip]' 行出现 且 '[attn-prewarm] rank=N done: **0** dummy forward(s)' ×4; done 计数 ≠0 而 [prewarm-skip] 也在 ⇒ 两条路都跑了, 异常"
