export CUDA_DEVICE_ORDER CUDA_VISIBLE_DEVICES
# env-builder 实测必需的运行前置 (否则 JIT / FlashInfer 找不到 nvcc):
#   nvcc 13.2.51 不在默认 PATH; libstdcxx 等在 env/lib
: "${CUDA_HOME:=/usr/local/cuda}"
export CUDA_HOME
export PATH="/usr/local/cuda/bin:${LSGLANG_VENV}/bin:${PATH}"
if [[ -d "${LSGLANG_VENV}/lib" ]]; then
  export LD_LIBRARY_PATH="${LSGLANG_VENV}/lib:${LD_LIBRARY_PATH:-}"
fi
SGLANG_BIN="${LSGLANG_VENV}/bin/sglang"

# 组装 argv; MAX_TOTAL_TOKENS 非空 → 剔除内联的 --max-total-tokens, 用覆盖值
SERVE_ARGS=()
_skip_next=0
for _a in "${SERVE_COMMON_ARGS[@]}"; do
  if (( _skip_next )); then _skip_next=0; continue; fi
  if [[ -n "$MAX_TOTAL_TOKENS" && "$_a" == "--max-total-tokens" ]]; then _skip_next=1; continue; fi
  SERVE_ARGS+=("$_a")
done
unset _a _skip_next
[[ -n "$MAX_TOTAL_TOKENS" ]] && SERVE_ARGS+=(--max-total-tokens "$MAX_TOTAL_TOKENS")
# 【2026-10-23 · 用户指示"现在需要上 dspark 了"】对齐厂商脚本三件套
# 厂商依据: launch/sglang_serve_0731_dspark_tp2_3090.sh:56-58
if [[ "$SPEC_ENABLED" == "1" ]]; then
  SERVE_ARGS+=(--speculative-algorithm DSPARK --speculative-dspark-block-size 5 --speculative-attention-mode decode --speculative-use-rejection-sampling)
fi
# --- CUDA graph 显存压力调节阀 ---------------------------------------------
# 图捕获显存**不进** KV 池预算 (envs.SGLANG_ENABLE_POST_CAPTURE_KV_SIZING 默认 False;
# 且 post_capture_kv_sizing_planned() 对 MLA 模型 return False) ⇒ 必须由 0.88 的余量覆盖。
# 余量 = pre_model_load_memory × (1−0.88) ≈ 9.56 GiB/卡, 且 pre_capture_activation_reserve_mb()
# 对 >60GiB 卡有 max(..., 10*1024 MB) 下限 ⇒ 实际可用余量 ≈ **10 GiB/卡**。
# 本栈默认 decode 图 max_bs = 512 (H100 + tp4, memory_hook.py:118-136) 而
# --max-running-requests=16 ⇒ 捕获到 512 纯属浪费, 是这块余量的首要消耗者。
# 注意: 本版本**没有** `--cuda-graph-max-bs`, 正确拼写带 -decode/-prefill 后缀。
if [[ -n "$CUDA_GRAPH_MAX_BS" ]]; then
  SERVE_ARGS+=(--cuda-graph-max-bs-decode "$CUDA_GRAPH_MAX_BS")
  SERVE_ARGS+=(--cuda-graph-max-bs-prefill "$CUDA_GRAPH_MAX_BS")
fi
# 注意: disable_cuda_graph 字段是 Arg(no_cli=True) ⇒ 不要用 --disable-cuda-graph,
#       官方替代写法是 --cuda-graph-backend-{decode,prefill}=disabled
if [[ -n "$CUDA_GRAPH_BACKEND" ]]; then
  SERVE_ARGS+=(--cuda-graph-backend-decode "$CUDA_GRAPH_BACKEND")
  SERVE_ARGS+=(--cuda-graph-backend-prefill "$CUDA_GRAPH_BACKEND")
fi
# --- ep-size: 刻意留空 = 用默认 1 (池才有 384 个本地专家, 192 槽才成立) ---
if [[ ${#SERVE_EP_ARGS[@]} -gt 0 ]]; then SERVE_ARGS+=("${SERVE_EP_ARGS[@]}"); fi
if [[ ${#SERVE_EXTRA_ARGS[@]} -gt 0 ]]; then SERVE_ARGS+=("${SERVE_EXTRA_ARGS[@]}"); fi
SERVE_ARGS+=(--host "$HOST" --port "$PORT")
FULL_CMD=("$SGLANG_BIN" serve --model "$MODEL_PATH" "${SERVE_ARGS[@]}")
[[ -n "$SERVED_MODEL_NAME" ]] && FULL_CMD+=(--served-model-name "$SERVED_MODEL_NAME")

