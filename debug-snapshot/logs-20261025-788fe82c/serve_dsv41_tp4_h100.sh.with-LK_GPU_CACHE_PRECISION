# -----------------------------------------------------------------------------
# 2. 命令行
# -----------------------------------------------------------------------------
MODE="background"; WAIT_FOR_READY=1; SKIP_GPU_IDLE_CHECK=0; SKIP_BIN_CHECK=0
DO_RESTART=0; DO_SELFCHECK=0

usage() {
  cat <<'USAGE_EOF'
serve_dsv41_tp4_h100.sh   【定稿版】
  DeepSeek-V4.1-Flash-1017 · Lsglang 1.6.1 · TP4 × 4×H100 80GB (SM90)
  物理卡 4-7 (UUID 固定), NUMA node1, 端口 18010
  前 20 层 (0-19) GPU-resident → W4A8; 后 20 层 → 192 槽专家池

用法:
  ./serve_dsv41_tp4_h100.sh                 # 后台拉起并等待就绪 + 自动跑 W4A8 自检
  ./serve_dsv41_tp4_h100.sh --dry-run       # 只做 preflight + 打印将要执行的命令, 不启动
  ./serve_dsv41_tp4_h100.sh --self-check    # 不启动; 对当前(或最近一次)日志跑 W4A8 自检
  ./serve_dsv41_tp4_h100.sh --foreground    # 前台运行 (Ctrl-C 停止)
  ./serve_dsv41_tp4_h100.sh --restart       # 若已在跑则先优雅停止再启动
  ./serve_dsv41_tp4_h100.sh --no-wait       # 后台拉起后立刻返回, 不等 /health
  ./serve_dsv41_tp4_h100.sh --skip-gpu-idle-check   # 跳过"卡必须空闲"断言
  ./serve_dsv41_tp4_h100.sh --allow-missing-sglang  # env 未装好时也能跑 preflight 演示
  ./serve_dsv41_tp4_h100.sh --help

产物: 日志/PID -> logs/ ;  快照 -> configs/*.effective.<ts>.conf ;  **不写 /tmp**
退出码: 0 成功 ; 1 preflight/启动失败 或 自检失败 ; 2 参数错误
USAGE_EOF
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n)           MODE="dry-run" ;;
    --foreground|-f)        MODE="foreground" ;;
    --self-check)           DO_SELFCHECK=1 ;;
    --restart)              DO_RESTART=1 ;;
    --no-wait)              WAIT_FOR_READY=0 ;;
    --skip-gpu-idle-check)  SKIP_GPU_IDLE_CHECK=1 ;;
    --allow-missing-sglang) SKIP_BIN_CHECK=1 ;;
    --help|-h)              usage; exit 0 ;;
    *) echo "未知参数: $1 (用 --help)" >&2; exit 2 ;;
  esac
  shift
done

# -----------------------------------------------------------------------------
# 3. 工具
# -----------------------------------------------------------------------------
ts()      { date '+%Y-%m-%d %H:%M:%S'; }
log()     { printf '[%s] %s\n' "$(ts)" "$*"; }
log_err() { printf '[%s] ERROR: %s\n' "$(ts)" "$*" >&2; }
die()     { log_err "$*"; exit 1; }

PREFLIGHT_FAIL=0
chk_ok()   { printf '  [ OK ]   %s\n' "$*"; }
chk_bad()  { printf '  [FAIL]   %s\n' "$*"; PREFLIGHT_FAIL=$((PREFLIGHT_FAIL + 1)); }
chk_warn() { printf '  [WARN]   %s\n' "$*"; }

shell_quote() {
  local s="$1"
  [[ -z "$s" ]] && { printf "''"; return; }
  if [[ "$s" =~ ^[A-Za-z0-9_@%+=:,./-]+$ ]]; then printf '%s' "$s"; return; fi
  printf "'%s'" "${s//\'/\'\\\'\'}"
}
quote_cmd() { local a out=""; for a in "$@"; do out+="$(shell_quote "$a") "; done; printf '%s' "${out% }"; }

RUN_TS="$(date '+%Y%m%d_%H%M%S')"
mkdir -p "$RUN_DIR" "$CONF_SNAPSHOT_DIR"
: "${PID_FILE:=${RUN_DIR}/serve_dsv41_tp4_h100.pid}"
: "${LOG_PREFIX:=serve_dsv41_tp4_h100}"
