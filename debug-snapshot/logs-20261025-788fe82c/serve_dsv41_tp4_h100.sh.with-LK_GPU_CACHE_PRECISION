}

if [[ "$MODE" == "foreground" ]]; then
  dump_header
  log "前台运行 (Ctrl-C 停止)。日志同时写: $LOG_FILE"
  exec "${FULL_CMD[@]}" 2>&1 | tee -a "$LOG_FILE"
  exit "${PIPESTATUS[0]}"
fi

dump_header
log "GPU 可见: CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
setsid "${FULL_CMD[@]}" >>"$LOG_FILE" 2>&1 </dev/null &
launched_pid=$!

sleep 3
if ! kill -0 "$launched_pid" 2>/dev/null; then
  log_err "进程启动后立即退出 (PID ${launched_pid})。日志尾部:"
  tail -n "$STATUS_TAIL_LINES" "$LOG_FILE" >&2 || true
  die "启动失败, 详见 $LOG_FILE"
fi

actual_pgid="$(ps -o pgid= -p "$launched_pid" 2>/dev/null | tr -d ' ' || true)"; : "${actual_pgid:=$launched_pid}"
{
  echo "# 由 serve_dsv41_tp4_h100.sh 自动生成 —— 停止脚本只操作这里记录的 PID/PGID"
  # ⚠ 必须用 %q 引用: START_TS 含空格 ("2026-10-22 16:11:50"), 裸 %s 会让
  #   `source <pidfile>` 把 "16:11:50" 当命令执行 → 停止脚本报
  #   "line 4: 16:11:50: command not found" 并**拒绝杀进程** (2026-10-22 实测踩到)。
  printf 'PID=%q\nPGID=%q\nSTART_TS=%q\nPORT=%q\nLOG_FILE_RECORDED=%q\nSNAP_FILE=%q\nLAUNCHER_PID=%q\n' \
    "$launched_pid" "$actual_pgid" "$(ts)" "$PORT" "$LOG_FILE" "$SNAP_FILE" "$$"
} > "$PID_FILE"

log "已拉起 PID=${launched_pid} PGID=${actual_pgid}, 日志: $LOG_FILE"
log "PID 记录: $PID_FILE"

if [[ "$WAIT_FOR_READY" -eq 0 ]]; then
  log "--no-wait: 立刻返回。就绪后跑: $0 --self-check"
  exit 0
fi

# -----------------------------------------------------------------------------
# 11. 等待就绪
# -----------------------------------------------------------------------------
log "等待 /health 就绪 (上限 ${STARTUP_TIMEOUT_S}s; 475 GiB 权重从 NFS 冷读 + 上池较慢, 属正常)…"
deadline=$(( SECONDS + STARTUP_TIMEOUT_S )); last_note=-1
while (( SECONDS < deadline )); do
  if ! kill -0 "$launched_pid" 2>/dev/null; then
    log_err "进程已退出 (PID ${launched_pid})。日志尾部:"
    tail -n "$STATUS_TAIL_LINES" "$LOG_FILE" >&2 || true
    rm -f "$PID_FILE"
    die "启动过程中进程死亡, 详见 $LOG_FILE"
  fi
  if curl -sf -m "$HEALTH_CURL_TIMEOUT_S" "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
    log "✅ /health 就绪, 耗时约 $(( STARTUP_TIMEOUT_S - (deadline - SECONDS) ))s。端点 http://${HOST}:${PORT}"
    run_self_check "$LOG_FILE"
    sc=$?
    echo
    if (( sc == 0 )); then log "下一步: ./status.sh  |  ./health.sh (含最小 chat 推理)"; exit 0
    else log_err "⚠ 服务已就绪但 W4A8 自检失败 —— 开关可能没生效, 请先按上面提示排查"; exit 1; fi
  fi
  note=$(( (deadline - SECONDS) / 60 ))
  if (( note != last_note )); then
    log "  仍在加载… 剩余约 ${note} 分钟 (日志尾: $(tail -n 1 "$LOG_FILE" 2>/dev/null | cut -c1-110))"; last_note=$note
  fi
  sleep 5
done

log_err "等待 /health 超过 ${STARTUP_TIMEOUT_S}s 仍未就绪。进程仍在 (PID ${launched_pid})。"
tail -n "$STATUS_TAIL_LINES" "$LOG_FILE" >&2 || true
die "超时。可用 ./status.sh 查看 / ./stop_dsv41_tp4_h100.sh 停止。日志: $LOG_FILE"
