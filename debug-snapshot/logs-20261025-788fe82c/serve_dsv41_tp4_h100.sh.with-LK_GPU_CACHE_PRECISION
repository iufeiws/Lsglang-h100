  [SGLANG_DSV41_AUTOTUNE_DUMMY_DECODE]="$SGLANG_DSV41_AUTOTUNE_DUMMY_DECODE"
  [SGLANG_DSV41_SWA_PAD_SENTINEL]="$SGLANG_DSV41_SWA_PAD_SENTINEL"
  [SGLANG_DSV41_POST_CONVERT_RELEASE]="$SGLANG_DSV41_POST_CONVERT_RELEASE"
  [SGLANG_DSV41_DUMP_FLASHMLA_ARGS]="$SGLANG_DSV41_DUMP_FLASHMLA_ARGS"
  [CUDA_LAUNCH_BLOCKING]="$CUDA_LAUNCH_BLOCKING"
  [PYTORCH_CUDA_ALLOC_CONF]="$PYTORCH_CUDA_ALLOC_CONF"   # 试验A
)
declare -A UNSET_NOTE=(
  [SGLANG_DSV4_FP4_DEQUANT]="必须保持未设(False): deepseek_v4.py:80 用它作 auto→flashinfer_mxfp4 的门, 设 1 会选不到"
  [SGLANG_SM8X_MARLIN_GROUP32]="SM90 无效 (fp8.py:562 要求 80<=cap<89); 已删除"
  [SGLANG_SM8X_MARLIN_GROUP32_ONLY]="SM90 无效; 已删除"
)
export_env_vars() { local k; for k in "${!EXPORT_ENV[@]}"; do [[ -n "${EXPORT_ENV[$k]}" ]] && export "$k=${EXPORT_ENV[$k]}"; done; }
sorted_env_lines() {
  local k
  for k in $(printf '%s\n' "${!EXPORT_ENV[@]}" | LC_ALL=C sort); do
    [[ -n "${EXPORT_ENV[$k]}" ]] && printf 'export %s=%s\n' "$k" "$(shell_quote "${EXPORT_ENV[$k]}")"
  done
}

write_snapshot() {
  {
    echo "# Lsglang serve 有效配置快照 (自动生成, 勿手改)  【定稿版】"
    echo "# 生成: $(ts)   主机: $(hostname)   调用者: ${USER:-$(id -un)}"
    echo "# conf 来源: ${CONF_LOADED}"
    echo "# 日志: $LOG_FILE"
    echo "# 方案: 前 20 层(0-19) GPU-resident → W4A8 ; 后 20 层 → ${LK_POOL_SLOTS} 槽池 (闭源 W4A16 等价)"
    echo
    echo "# ---- 导出到进程的环境变量 (按字母序) ----"
    sorted_env_lines
    echo
    echo "# ---- 未导出 (留空, 交由上游默认) ----"
    local k
    for k in $(printf '%s\n' "${!EXPORT_ENV[@]}" | LC_ALL=C sort); do
      [[ -z "${EXPORT_ENV[$k]}" ]] && printf '# (空) %s\n' "$k"
    done
    echo
    echo "# ---- 必须保持未设 ----"
    for k in $(printf '%s\n' "${!UNSET_NOTE[@]}" | LC_ALL=C sort); do
      printf '# (不设) %s —— %s\n' "$k" "${UNSET_NOTE[$k]}"
    done
    echo
    echo "# ---- 完整命令行 ----"
    echo "$(quote_cmd "${FULL_CMD[@]}")"
    echo
    echo "# ---- 期望的 W4A8 日志串 ----"
    echo "#   ${SELFCHECK_EXPECT_STR}"
    echo "# 禁止出现的 ----"
    echo "#   ${SELFCHECK_FORBID_STR}"
    echo
    echo "# ---- GPU UUID -> 物理序号 ----"
    local i
    for i in "${!GPU_UUIDS[@]}"; do echo "#   ${GPU_UUIDS[$i]}  ->  物理 GPU${GPU_EXPECTED_INDEXES[$i]}"; done
  } > "$SNAP_FILE"
}

load_pidfile() {
  RPID=""; RPGID=""; RSTART_TS=""; RLOG=""; RSNAP=""
  [[ -f "$PID_FILE" ]] || return 0
  local out
  out="$( { set +u; # shellcheck source=/dev/null
      . "$PID_FILE" 2>/dev/null || true
      printf 'RPID=%s\nRPGID=%s\nRSTART_TS=%s\nRLOG=%s\nRSNAP=%s\n' \
        "${PID:-}" "${PGID:-}" "${START_TS:-}" "${LOG_FILE_RECORDED:-}" "${SNAP_FILE:-}"; } )"
  eval "$out" 2>/dev/null || true
}

latest_log() {
  if [[ -n "${RLOG:-}" && -f "$RLOG" ]]; then printf '%s' "$RLOG"
  else ls -1t "${RUN_DIR}/${LOG_PREFIX}"_*.log 2>/dev/null | head -1 || true; fi
}

# -----------------------------------------------------------------------------
# 5. 启动后自检 (W4A8 是否真的生效)
# -----------------------------------------------------------------------------
run_self_check() {
  local lf="$1"
  local rc=0
  echo
  echo "=============================================================="
  echo " 启动后自检 · W4A8 开关是否生效"
  echo "=============================================================="
  if [[ -z "$lf" || ! -f "$lf" ]]; then
    log_err "找不到日志文件, 无法自检 (查 ${RUN_DIR})"; return 1
  fi
  echo " 日志: $lf"
  echo "--------------------------------------------------------------"

  local n_expect n_forbid n_w4a16_res
  # ⚠ 必须剔除本脚本自己写入的 "自检断言" 横幅行 —— 那行原文引用了这些串, 否则假阳性。
  # 【2026-10-23 05:0x】变量名与标签已改为模式无关 (原 n_w4a8 实际数的是 EXPECT 串, 标签却写 W4A8 → 误导)。
  n_expect="$(grep -v '自检断言' "$lf" 2>/dev/null | grep -cF "$SELFCHECK_EXPECT_STR" || true)"
  n_forbid="$(grep -v '自检断言' "$lf" 2>/dev/null | grep -cF "$SELFCHECK_FORBID_STR" || true)"

  echo "1) 期望串 [${SELFCHECK_EXPECT_STR:0:40}] 命中行数: ${n_expect}  (硬门槛 >= ${SELFCHECK_MIN_W4A8_LINES})"
  if (( n_expect >= SELFCHECK_MIN_W4A8_LINES )); then
    printf '  [ OK ]   ✓ 建池成功 (EXPECT 串出现)\n'
    grep -v '自检断言' "$lf" | grep -F "$SELFCHECK_EXPECT_STR" | head -3 | cut -c1-200 | sed 's/^/           /'
  elif [[ "${ALLOW_NO_W4A8:-0}" == "1" ]]; then
    printf '  [SKIP]   ALLOW_NO_W4A8=1: 本档不要求该串, 不计失败\n'
  else
    printf '  [ALARM]  ✗ 未出现期望串 —— 建池可能没发生\n'
    rc=1
  fi

  echo
  echo "2) 禁止串 (CUTLASS W4A8) 命中行数: ${n_forbid}  (必须 0, 任何模式都不该出现)"
  if (( n_forbid == 0 )); then
    printf '  [ OK ]   ✓ 没有落在 W4A8 路径\n'
  else
    printf '  [ALARM]  ✗ 出现了 W4A8 —— 与预期不符, 立即人工介入!\n'
    grep -F "$SELFCHECK_FORBID_STR" "$lf" | head -5 | sed 's/^/           /'
    rc=1
  fi

  # 【2026-10-23 05:0x 新增】resident 模式的**条件断言**: 仅当 resident 列表非空时才要求 W4A16 行,
  #   避免全池模式 (resident 为空) 误报。全池模式下这两类串都不会出现 —— 属正常, 跳过。
  echo
  echo "2b) [条件断言] resident 模式下应有 CUTLASS W4A16 行"
  if [[ -z "${LK_GPU_RESIDENT_MOE_LAYERS:-}" ]]; then
    printf '  [SKIP]   LK_GPU_RESIDENT_MOE_LAYERS 为空 (全池模式) ⇒ 不要求 W4A16 串, 不计失败\n'
  else
    n_w4a16_res="$(grep -v '自检断言' "$lf" 2>/dev/null | grep -cF 'CUTLASS W4A16 (layer:' || true)"
    if (( n_w4a16_res >= 1 )); then
      printf '  [ OK ]   ✓ resident=%s ⇒ CUTLASS W4A16 行数=%s\n' "$LK_GPU_RESIDENT_MOE_LAYERS" "$n_w4a16_res"
    else
      printf '  [ALARM]  ✗ resident=%s 非空但 CUTLASS W4A16 行数=0 —— resident 转换路径没跑?\n' "$LK_GPU_RESIDENT_MOE_LAYERS"
      rc=1
    fi
  fi

  echo
  echo "3) MoE runner backend 是否落在 ${SELFCHECK_EXPECT_RUNNER}"
  if grep -qF "$SELFCHECK_EXPECT_RUNNER" "$lf" 2>/dev/null; then
    printf '  [ OK ]   ✓ 日志含 %s\n' "$SELFCHECK_EXPECT_RUNNER"
    grep -F "$SELFCHECK_EXPECT_RUNNER" "$lf" | tail -3 | sed 's/^/           /'
  else
    printf '  [WARN]   日志未出现 %s (可能与 1) 同一原因)\n' "$SELFCHECK_EXPECT_RUNNER"; rc=1
  fi

  echo
  echo "4) 故障定位提示 (R2 / 精度)"
  if (( n_forbid > 0 )); then
    echo "  ⚠ 出现了 CUTLASS W4A8 串 —— 与预期不符 (当前应走 W4A16), 先查精度开关:"
    echo "   a) LK_GPU_RESIDENT_MOE_LAYERS 是否为空? 当前 = '${LK_GPU_RESIDENT_MOE_LAYERS}'"
    echo "      空 ⇒ 全部 40 层进池 ⇒ resident=0 ⇒ W4A8 必然不出现 (mxfp4_flashinfer_cutlass_moe.py:144)"
    echo "   b) --moe-runner-backend 是否仍是 flashinfer_mxfp4 ? 当前 = 'flashinfer_mxfp4'"
    echo "   c) --flashinfer-mxfp4-moe-precision 是否为 fp8 ? (default → W4A16)"
    echo "   d) SGLANG_DSV4_FP4_DEQUANT 是否被设了? 设了会让 auto 选不到 flashinfer_mxfp4"
    echo "   e) 有没有出现 'Preparing DSv4 MXFP4 experts for FlashInfer CUTLASS' (无 arch) 的其它变体?"
    grep -oE "Preparing DSv4 MXFP4 experts for FlashInfer [^(]*" "$lf" 2>/dev/null | sort -u | sed 's/^/      /' || true
  fi

  echo
  echo "5) 旁证 (池 / KV / 显存)"
  grep -oE "\[pool\] slab:[^(]*|max_total_num_tokens[^,]*|Preparing.*|Available memory:[^,]*" "$lf" 2>/dev/null \
    | tail -8 | sed 's/^/      /' || true

  echo
  echo "--------------------------------------------------------------"
  if (( rc == 0 )); then
    echo " 自检结果: 通过 ✅  (EXPECT='${SELFCHECK_EXPECT_STR:0:30}' 命中 ${n_expect} 行; W4A8 禁止串 ${n_forbid} 行)"
  else
    echo " 自检结果: 失败 ❌  见上方 ALARM"
  fi
  echo "=============================================================="
  return $rc
}

# -----------------------------------------------------------------------------
# 6. --self-check 单独模式 (不启动)
# -----------------------------------------------------------------------------
if [[ "$DO_SELFCHECK" -eq 1 && "$MODE" != "dry-run" ]]; then
  load_pidfile
  if [[ -n "$RPID" ]] && kill -0 "$RPID" 2>/dev/null; then
    echo "服务在运行 (PID ${RPID}), 对当前日志自检:"
  else
    echo "服务未运行, 对最近一次日志自检:"
  fi
  lf="$(latest_log)"
  [[ -n "$lf" ]] || die "找不到任何日志 (${RUN_DIR}/${LOG_PREFIX}_*.log)"
  run_self_check "$lf"; exit $?
fi

print_header() {
  echo "=============================================================="
  echo " Lsglang serve 【定稿版】· DeepSeek-V4.1-Flash-1017 · TP4 × 4×H100"
  echo "=============================================================="
  echo " 模式         : $MODE"
  echo " conf         : $CONF_LOADED"
  echo " venv 入口    : $SGLANG_BIN"
  echo " 权重         : $MODEL_PATH"
  echo " 端点         : http://${HOST}:${PORT}"
  echo " GPU(UUID)    : $CUDA_VISIBLE_DEVICES"
  echo " 专家方案     : resident=${LK_GPU_RESIDENT_MOE_LAYERS:-<空!>} (W4A8) + pool=${LK_POOL_SLOTS} 槽 (W4A16 等价)"
  echo " 日志         : $LOG_FILE"
  echo " PID 文件     : $PID_FILE"
  echo "--------------------------------------------------------------"
}

# -----------------------------------------------------------------------------
# 7. 幂等
# -----------------------------------------------------------------------------
if [[ "$MODE" != "dry-run" && "$DO_SELFCHECK" -eq 0 ]]; then
  load_pidfile
  if [[ -n "$RPID" ]] && kill -0 "$RPID" 2>/dev/null; then
    etime="$(ps -o etime= -p "$RPID" 2>/dev/null | tr -d ' ' || echo '?')"
    echo "=============================================================="
    echo " 服务已在运行 —— 本次不重复拉起 (幂等)"
    echo "=============================================================="
    echo " PID/PGID   : ${RPID} / ${RPGID:-?}"
    echo " 启动时间   : ${RSTART_TS:-?}  (已运行 ${etime})"
    echo " 日志       : ${RLOG:-?}"
    if curl -sf -m "$HEALTH_CURL_TIMEOUT_S" "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
      echo " /health    : 200 OK (就绪)  ->  http://${HOST}:${PORT}/v1"
    else
      echo " /health    : 未就绪 / 未响应 (看 ./status.sh)"
    fi
    if [[ "$DO_RESTART" -eq 1 ]]; then
      echo "--------------------------------------------------------------"
      log "--restart: 先优雅停止 PID ${RPID} …"
      [[ -x "${SCRIPT_DIR}/stop_dsv41_tp4_h100.sh" ]] || die "找不到 ${SCRIPT_DIR}/stop_dsv41_tp4_h100.sh"
      "${SCRIPT_DIR}/stop_dsv41_tp4_h100.sh" || die "停止失败, 中止 --restart"
      sleep 3; log "已停止, 继续启动新实例。"
    else
      echo "--------------------------------------------------------------"
      echo " 需要重启: $0 --restart   或   ./stop_dsv41_tp4_h100.sh && $0"
      echo " W4A8 自检: $0 --self-check"
      exit 0
    fi
  elif [[ -n "$RPID" ]]; then
    log "清理陈旧 PID 文件 (PID ${RPID} 已不存在): $PID_FILE"; rm -f "$PID_FILE"
  fi
fi

# -----------------------------------------------------------------------------
# 8. Preflight
# -----------------------------------------------------------------------------
echo "=============================================================="
print_header
echo " Preflight 检查"
echo "--------------------------------------------------------------"

echo "1) 端口 ${PORT}"
port_owner_pid=""
if command -v ss >/dev/null 2>&1; then
  port_owner_pid="$(ss -ltnp "sport = :${PORT}" 2>/dev/null | awk 'NR>1' | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2 || true)"
fi
if [[ -z "$port_owner_pid" ]]; then chk_ok "端口 ${PORT} 空闲"
else chk_bad "端口 ${PORT} 已被 PID ${port_owner_pid} 占用 ($(ps -o comm= -p "$port_owner_pid" 2>/dev/null || echo '?'))"; fi

echo "2) 依赖文件"
if [[ -x "$SGLANG_BIN" ]]; then
  chk_ok "sglang 入口存在且可执行: $SGLANG_BIN"
  sg_ver="$("$SGLANG_BIN" --version 2>/dev/null | tail -1 || true)"
  [[ -n "$sg_ver" ]] && chk_ok "sglang --version: $sg_ver"
elif [[ "$SKIP_BIN_CHECK" -eq 1 ]]; then
  chk_warn "sglang 入口缺失 (已用 --allow-missing-sglang 忽略): $SGLANG_BIN"
else
  chk_bad "sglang 入口缺失或不可执行: $SGLANG_BIN  (env 可能还没装完)"
fi
if [[ -d "$LSGLANG_REPO" ]]; then
  v="$(grep -m1 '^version' "$LSGLANG_REPO/python/pyproject.toml" 2>/dev/null | tr -d ' ",' | cut -d= -f2 || true)"
  rv="$(grep -m1 '"lk_moe==' "$LSGLANG_REPO/python/pyproject.toml" 2>/dev/null | tr -d ' ",' | sed 's/.*lk_moe==//' || true)"
  chk_ok "仓库工作树存在; pyproject version=${v:-?}, 钉 lk_moe==${rv:-?}"
else
  chk_warn "仓库工作树不存在 (仅影响版本核对): $LSGLANG_REPO"
fi
if [[ -d "$MODEL_PATH" && -f "$MODEL_PATH/config.json" ]]; then
  chk_ok "权重目录存在; config.json 存在; safetensors 分片 $(ls "$MODEL_PATH"/model-*-of-*.safetensors 2>/dev/null | wc -l) 个"
else
  chk_bad "权重目录或 config.json 缺失: $MODEL_PATH"
fi

echo "3) GPU 绑定 (UUID)"
gpu_l_listing="$(nvidia-smi -L 2>/dev/null || true)"
if [[ -z "$gpu_l_listing" ]]; then
  chk_bad "nvidia-smi -L 无输出 (驱动异常?)"
else
  mapfile -t gpu_pairs < <(printf '%s\n' "$gpu_l_listing" | sed -n 's/^GPU \([0-9]\+\):.*(UUID: \(GPU-[^)]*\)).*/\1 \2/p')
  idx_of_uuid() { local want="$1" l; for l in "${gpu_pairs[@]}"; do [[ "${l##* }" == "$want" ]] && { printf '%s' "${l%% *}"; return 0; }; done; return 1; }
  desc_of_uuid() { local i; if i="$(idx_of_uuid "$1")"; then printf '物理 GPU%s' "$i"; else printf '(未找到)'; fi; }
  for i in "${!GPU_UUIDS[@]}"; do
    u="${GPU_UUIDS[$i]}"; exp="${GPU_EXPECTED_INDEXES[$i]}"
    if got="$(idx_of_uuid "$u")"; then
      [[ "$got" == "$exp" ]] && chk_ok "UUID ${u} -> 物理 GPU${got} (与期望一致)" \
                             || chk_bad "UUID ${u} -> 物理 GPU${got}, 期望 GPU${exp}"
    else chk_bad "UUID ${u} 不在 nvidia-smi -L 输出中"; fi
  done
  for f in "${GPU_FORBIDDEN_UUIDS[@]}"; do
    if printf '%s\n' "${GPU_UUIDS[@]}" | grep -qxF "$f"; then
      chk_bad "禁止使用的 UUID ${f} ($(desc_of_uuid "$f")) 混入了可见列表"
    else chk_ok "禁止卡 $(desc_of_uuid "$f") 未出现在可见列表中"; fi
  done

  echo "4) 目标卡显存占用 (阈值 < ${GPU_IDLE_MAX_USED_MIB} MiB)"
  q="$(nvidia-smi --query-gpu=index,uuid,memory.used --format=csv,noheader,nounits 2>/dev/null || true)"
  if [[ -z "$q" ]]; then chk_bad "nvidia-smi 查询显存失败"
  else
    for i in "${!GPU_UUIDS[@]}"; do
      u="${GPU_UUIDS[$i]}"
      used="$(printf '%s\n' "$q" | awk -F', *' -v u="$u" '$2==u{print $3}' | head -1)"
      if [[ -z "$used" ]]; then chk_bad "查不到 UUID ${u} 的显存占用"
      elif (( used < GPU_IDLE_MAX_USED_MIB )); then chk_ok "物理 GPU${GPU_EXPECTED_INDEXES[$i]} (${u:0:18}…) 已用 ${used} MiB — 空闲"
      elif [[ "$SKIP_GPU_IDLE_CHECK" -eq 1 ]]; then chk_warn "物理 GPU${GPU_EXPECTED_INDEXES[$i]} 已用 ${used} MiB ≥ 阈值 (已跳过检查)"
      else chk_bad "物理 GPU${GPU_EXPECTED_INDEXES[$i]} 已用 ${used} MiB ≥ 阈值 ${GPU_IDLE_MAX_USED_MIB} MiB"; fi
    done
  fi
fi

echo "5) CPU / NUMA / 方案一致性自检"
phys_cores="$(lscpu -p=Core,Socket 2>/dev/null | grep -v '^#' | sort -u | wc -l)"
chk_ok "逻辑 CPU $(nproc 2>/dev/null || echo '?'), 物理核 ${phys_cores}"
if [[ "$phys_cores" =~ ^[0-9]+$ ]] && (( phys_cores > 0 )); then
  auto_threads=$(( phys_cores / ${#GPU_UUIDS[@]} ))
  if [[ "$LK_THREADS" == "$auto_threads" ]]; then
    chk_ok "LK_THREADS=${LK_THREADS} 等于 README 公式值 (物理核 ${phys_cores} ÷ ${#GPU_UUIDS[@]} 卡)"
  else
    chk_warn "LK_THREADS=${LK_THREADS} ≠ README 公式值 ${auto_threads} (lead 定稿值, 保留; 仅提示)"
  fi
fi
if [[ "$LK_NUMA_INTERLEAVE" == "1" ]]; then chk_ok "LK_NUMA_INTERLEAVE=1 (host 常驻 464.6 GiB > node1 的 401.8 GiB, 必须开)"
else chk_bad "LK_NUMA_INTERLEAVE=${LK_NUMA_INTERLEAVE} — 关闭会 node OOM"; fi
if [[ "$LK_MOE_HYBRID_ENABLED" == "1" ]]; then chk_ok "LK_MOE_HYBRID_ENABLED=1 (总开关)"
else chk_bad "LK_MOE_HYBRID_ENABLED=${LK_MOE_HYBRID_ENABLED} — 必须 1"; fi

# ---- R2 守卫: resident 层必须非空, 否则 W4A8 是空转 ----
w4a8_requested=0
for _a in "${SERVE_ARGS[@]}"; do [[ "$_a" == "fp8" ]] && w4a8_requested=1; done
if [[ "$w4a8_requested" -eq 1 ]]; then
  if [[ -z "$LK_GPU_RESIDENT_MOE_LAYERS" ]]; then
    chk_bad "R2! 用了 --flashinfer-mxfp4-moe-precision fp8 但 LK_GPU_RESIDENT_MOE_LAYERS 为空 —— 全部层进池 ⇒ resident=0 ⇒ W4A8 完全失效 (mxfp4_flashinfer_cutlass_moe.py:144)"
  else
    chk_ok "R2 守卫通过: LK_GPU_RESIDENT_MOE_LAYERS='${LK_GPU_RESIDENT_MOE_LAYERS}' 非空 ⇒ W4A8 有作用对象"
  fi
fi
if [[ -n "${SGLANG_DSV4_FP4_DEQUANT:-}" ]]; then
  chk_bad "SGLANG_DSV4_FP4_DEQUANT='${SGLANG_DSV4_FP4_DEQUANT}' 被设置了 —— 会导致 auto 选不到 flashinfer_mxfp4, 必须未设"
else
  chk_ok "SGLANG_DSV4_FP4_DEQUANT 未设 (必需)"
fi
if [[ -n "${SGLANG_SM8X_MARLIN_GROUP32:-}" || -n "${SGLANG_SM8X_MARLIN_GROUP32_ONLY:-}" ]]; then
  chk_warn "检测到 SM8x 专用 env —— SM90 上无效, 建议取消"
else
  chk_ok "未设置 SM8x MARLIN_GROUP32* (SM90 上无效, 已排除)"
fi
# 池/驻留算术提示 —— 公式**按 ep_size 分支** (2026-10-22 用实测值校正)
if [[ "$LK_POOL_SLOTS" =~ ^[0-9]+$ ]] && (( LK_POOL_SLOTS > 0 )); then
  # 完整专家字节 = 3 × moe_intermediate(2304) × hidden(5120) × 0.5 B(fp4) + ue8m0 块缩放 ≈ 18,800,640 B = 17.93 MiB
  #   ep_size=1: MoE 中间维按 TP4 切分  ⇒ 每槽 = 完整专家 / 4 = 4.70 MB
  #   ep_size>1: 中间维**不切分**      ⇒ 每槽 = 完整专家     = 18.80 MB (4× 于 ep1)
  # 实测校正依据 (2026-10-22 实例#4, ep4):
  #   [pool] slab: 16.81 GiB (20 layers x 860.62 MiB)  ⇒  860.62 MiB / 48 槽 = 17.93 MiB/槽 = 完整专家 ✓
  #   旧公式写死 4,700,160/4 = 4.48 MiB ⇒ 48 槽时把池估小了 **16 倍** (4× 来自 ep4, 另 4× 来自那个多余的 /4)。
  ep_size=1; _prev=""
  for _a in "${SERVE_ARGS[@]}"; do
    [[ "$_prev" == "--ep-size" ]] && ep_size="$_a"
    _prev="$_a"
  done
  unset _prev
  bytes_slot=$(( 18800640 ))
  (( ep_size == 1 )) && bytes_slot=$(( 18800640 / 4 ))
  # 池层数 = 总层数(40) − resident 层数; resident 列表支持 "a-b,c,d" 三种写法
  n_res=0
  if [[ -n "$LK_GPU_RESIDENT_MOE_LAYERS" ]]; then
    IFS=',' read -r -a _parts <<< "$LK_GPU_RESIDENT_MOE_LAYERS"
    for _p in "${_parts[@]}"; do
      _p="${_p// /}"
      if [[ "$_p" =~ ^([0-9]+)-([0-9]+)$ ]]; then n_res=$(( n_res + BASH_REMATCH[2] - BASH_REMATCH[1] + 1 ))
      elif [[ "$_p" =~ ^[0-9]+$ ]]; then n_res=$(( n_res + 1 )); fi
    done
    unset _parts _p
  fi
  n_pool_layers=$(( 40 - n_res )); (( n_pool_layers < 0 )) && n_pool_layers=0
  tot=$(awk -v s="$LK_POOL_SLOTS" -v n="$n_pool_layers" -v b="$bytes_slot" \
        'BEGIN{printf "%.2f", s*n*b/1024/1024/1024}')
  mib_slot=$(awk -v b="$bytes_slot" 'BEGIN{printf "%.2f", b/1024/1024}')
  chk_ok "池 slab ≈ ${tot} GiB/卡 (ep_size=${ep_size}: ${LK_POOL_SLOTS} 槽 × ${n_pool_layers} 层 × ${mib_slot} MiB/槽)"
  (( n_pool_layers == 0 )) && chk_warn "按 resident 列表('${LK_GPU_RESIDENT_MOE_LAYERS}')算出池层数 = 0, 池不会覆盖任何层"
fi

echo "--------------------------------------------------------------"
if (( PREFLIGHT_FAIL > 0 )); then echo " Preflight: ${PREFLIGHT_FAIL} 项失败"; else echo " Preflight: 全部通过"; fi
echo "--------------------------------------------------------------"

# -----------------------------------------------------------------------------
# 9. Dry-run
# -----------------------------------------------------------------------------
if [[ "$MODE" == "dry-run" ]]; then
  write_snapshot
  echo " 快照已写: $SNAP_FILE"
  echo "=============================================================="
  echo " 将要执行的环境与命令 (--dry-run, 未启动):"
  echo "=============================================================="
  echo; echo "# --- 环境变量 (导出) ---"; sorted_env_lines
  echo; echo "# --- 必须保持未设 ---"
  for k in $(printf '%s\n' "${!UNSET_NOTE[@]}" | LC_ALL=C sort); do printf '# (不设) %s —— %s\n' "$k" "${UNSET_NOTE[$k]}"; done
  echo; echo "# --- 命令 ---"; echo "$(quote_cmd "${FULL_CMD[@]}")"
  echo; echo "# --- 日志将落 ---"; echo "#   $LOG_FILE"; echo "#   $LOG_LINK  (软链)"
  echo; echo "# --- 就绪后自检将断言 ---"
  echo "#   必须出现: $SELFCHECK_EXPECT_STR"
  echo "#   禁止出现: $SELFCHECK_FORBID_STR"
  echo
  if (( PREFLIGHT_FAIL > 0 )); then echo "⚠ 有 ${PREFLIGHT_FAIL} 项 preflight 失败, 真实启动前必须解决。"; exit 1; fi
  echo "✅ dry-run 完成, preflight 全绿。"
  exit 0
fi

# -----------------------------------------------------------------------------
# 10. 硬门槛 + 启动
# -----------------------------------------------------------------------------
(( PREFLIGHT_FAIL > 0 )) && die "preflight 有 ${PREFLIGHT_FAIL} 项失败, 拒绝启动。修正后重试, 或先用 --dry-run 查看。"
log "preflight 通过, 准备启动"

export_env_vars
export PYTHONUNBUFFERED=1
write_snapshot
ln -sfn "$(basename "$LOG_FILE")" "$LOG_LINK" 2>/dev/null || true

